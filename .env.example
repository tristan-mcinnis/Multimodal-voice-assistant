## Copy to `.env` and fill in. `.env` is gitignored.

# --- LLM provider ---
# One of: deepseek (default), openai, anthropic, local
LLM_PROVIDER=deepseek

# DeepSeek (https://api-docs.deepseek.com/) — recommended default.
DEEPSEEK_API_KEY=
DEEPSEEK_PREFERRED_CHAT_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_PREFERRED_REASONING_MODEL=deepseek-v4-pro

# OpenAI
# OPENAI_API_KEY=
# OPENAI_PREFERRED_CHAT_MODEL=gpt-5

# Anthropic Claude
# ANTHROPIC_API_KEY=
# CLAUDE_PREFERRED_CHAT_MODEL=claude-opus-4-5-20251101

# Local (LM Studio)
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=local-model

# --- TTS provider ---
# One of: kokoro (local, default), openai
ASSISTANT_TTS_PROVIDER=kokoro
KOKORO_VOICE=af_sarah
KOKORO_STREAMING=true
# KOKORO_ONNX_MODEL_PATH=models/kokoro-v1.0.onnx
# KOKORO_VOICES_BIN_PATH=models/voices-v1.0.bin

# --- Tools ---
# ASSISTANT_DISABLE_TOOLS=false
# ASSISTANT_SIMPLE_TOOLS=false   # true => disables vision tools

# --- Wake word ---
# ASSISTANT_WAKE_WORD=nova
